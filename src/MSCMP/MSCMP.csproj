<Project Sdk="Microsoft.NET.Sdk">
  <!--
    MSC Multiplayer (MSCMP) - MSCLoader mod for My Summer Car.

    Build:   dotnet build src/MSCMP/MSCMP.csproj -c Release -p:GameDir="<path to My Summer Car>"
    Easiest: run scripts/build.ps1, which finds the game for you and also runs the API audit.

    The game's own assemblies are referenced from your installation and are never copied
    into the output or the repository.
  -->
  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <OutputType>Library</OutputType>
    <AssemblyName>MSCMP</AssemblyName>
    <RootNamespace>MSCMP</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <Nullable>disable</Nullable>
    <WarningLevel>4</WarningLevel>
    <NoWarn>$(NoWarn);CS0618</NoWarn>
    <GameDir Condition="'$(GameDir)' == ''">C:/Program Files (x86)/Steam/steamapps/common/My Summer Car</GameDir>
    <ManagedDir>$(GameDir)/mysummercar_Data/Managed</ManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="UnityEngine"><HintPath>$(ManagedDir)/UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MSCLoader"><HintPath>$(ManagedDir)/MSCLoader.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="PlayMaker"><HintPath>$(ManagedDir)/PlayMaker.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(ManagedDir)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp-firstpass"><HintPath>$(ManagedDir)/Assembly-CSharp-firstpass.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="cInput"><HintPath>$(ManagedDir)/cInput.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(ManagedDir)/0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <Target Name="CheckGameDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(ManagedDir)/MSCLoader.dll')"
           Text="Could not find My Summer Car with MSCLoader at '$(GameDir)'. Pass -p:GameDir=&quot;path to your My Summer Car folder&quot; (or use scripts/build.ps1)." />
  </Target>
</Project>
